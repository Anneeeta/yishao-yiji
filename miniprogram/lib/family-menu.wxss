.family { padding: 25rpx 34rpx calc(40rpx + env(safe-area-inset-bottom)); }
.family-title { font-size: 54rpx; line-height: 1.18; overflow-wrap: anywhere; }
.family-lead { margin: 10rpx 0 23rpx; font-size: 26rpx; line-height: 1.6; }
.family-count { color: #355b41; font-size: 24rpx; margin: 8rpx 0 13rpx; }
.family-panel { background: #fffdf6; border: 1rpx solid #dce0cf; padding: 21rpx; border-radius: 20rpx; margin: 17rpx 0; }
.family-label { display: block; font-size: 24rpx; font-weight: 650; margin-bottom: 8rpx; }
.family-input { display: flex; align-items: center; min-height: 70rpx; padding: 0 15rpx; background: #f8f7ee; border: 1rpx solid #dce0cf; border-radius: 13rpx; }
.family-input input { width: 100%; height: 42rpx; min-height: 0; padding: 0; font-size: 26rpx; line-height: 42rpx; }
.pick-list { background: #fffdf6; border: 1rpx solid #dce0cf; padding: 0 17rpx; border-radius: 18rpx; }
button.dish-choice { width: 100%; min-height: 84rpx; padding: 14rpx 4rpx; margin: 0; display: flex; justify-content: space-between; align-items: center; gap: 16rpx; line-height: 1.4; text-align: left; }
.dish-choice + .dish-choice, .line + .line { border-top: 1rpx solid #e7e8dc; }
.choice-title { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.choice-meta { color: #616c5b; font-size: 23rpx; margin-top: 3rpx; }
.selection-mark { flex: none; width: 39rpx; height: 39rpx; border: 2rpx solid #8fa387; border-radius: 9rpx; color: #fffdf5; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.selection-mark.selected { background: #355b41; border-color: #355b41; }
.family-actions { display: flex; flex-direction: column; gap: 12rpx; margin-top: 19rpx; }
.family-actions button { width: 100%; }
.help-text { color: #697460; font-size: 23rpx; line-height: 1.6; margin-top: 10rpx; }
.family-error { color: #963f32; font-size: 25rpx; margin-top: 10rpx; }
.section-title { font-size: 34rpx; }
.line { display: flex; gap: 13rpx; align-items: baseline; padding: 15rpx 0; }
.number { color: #466b4c; font-size: 23rpx; min-width: 31rpx; }
.line-title { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.order-note { white-space: pre-wrap; overflow-wrap: anywhere; padding: 13rpx 14rpx; border-radius: 11rpx; background: #edf0e1; margin-top: 13rpx; }
