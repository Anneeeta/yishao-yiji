.editor { padding-bottom: calc(155rpx + env(safe-area-inset-bottom)); }
button.voice-entry { width: 100%; margin-bottom: 19rpx; color: #294633; }
.cover-field { margin-bottom: 25rpx; }
.photo-button { height: 250rpx; width: 100%; position: relative; overflow: hidden; border: 2rpx dashed #b1baa4; color: #435946; border-radius: 22rpx; background: #edf0e3; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 12rpx; }
.photo-button.with-photo { border: 0; height: 340rpx; }
.photo-plus { font-size: 46rpx; }
.replace { position: absolute; right: 15rpx; bottom: 15rpx; background: #fffdf6; padding: 12rpx 19rpx; border-radius: 12rpx; font-size: 24rpx; }
.field { margin: 17rpx 0; min-width: 0; }
.field label, .field .label { display: block; margin-bottom: 8rpx; font-weight: 650; }
textarea, .input-field, .picker-value { background: #fffdf6; border: 1rpx solid #d8ddcb; border-radius: 14rpx; width: 100%; }
.input-field { min-height: 80rpx; display: flex; align-items: center; padding: 0 19rpx; }
.input-field input { width: 100%; height: 42rpx; min-height: 0; padding: 0; font-size: 28rpx; line-height: 42rpx; }
textarea { display: block; min-height: 146rpx; height: 146rpx; padding: 15rpx 19rpx; line-height: 1.5; }
.picker-value { min-height: 80rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 19rpx; }
.category-heading { display: flex; justify-content: space-between; align-items: baseline; }
.category-tools { display: flex; gap: 18rpx; }
button.category-action { width: auto; margin: 0; padding: 12rpx 16rpx; color: #355c42; font-size: 25rpx; line-height: 1.25; }
.category-heading .category-action { padding-right: 0; }
.category-form { margin-top: 12rpx; padding: 15rpx; border-radius: 15rpx; background: #eeeee3; }
.category-buttons { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 11rpx; }
button.category-save, button.category-save[disabled]:not([type]) { background: #294633; color: #fffdf5; border-radius: 12rpx; }
.category-list { margin-top: 12rpx; padding: 2rpx 15rpx; background: #fffdf6; border: 1rpx solid #d8ddcb; border-radius: 14rpx; }
.category-row { display: flex; align-items: center; justify-content: space-between; min-height: 65rpx; gap: 14rpx; }
.category-row + .category-row { border-top: 1rpx solid #e5e7db; }
.category-name { min-width: 0; overflow-wrap: anywhere; padding: 12rpx 4rpx; }
.category-default { font-size: 23rpx; flex: none; padding-right: 12rpx; }
button.category-delete { color: #a74e42; flex: none; }
.split { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.section { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #dce0cf; }
.section-head, .step-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.section-title { font-size: 39rpx; display: block; margin-bottom: 12rpx; }
.section-head .section-title { margin-bottom: 0; }
button.text-button { display: inline-block; width: auto; margin: 0; color: #355c42; font-size: 24rpx; padding: 14rpx 0; line-height: 1.25; }
.ingredient-row { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) 62rpx; gap: 9rpx; margin: 12rpx 0; align-items: center; }
.ingredient-tools { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 14rpx; }
.ingredient-options { grid-column: 1 / -1; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12rpx; align-items: center; padding-bottom: 10rpx; }
.ingredient-options .input-field { min-height: 62rpx; }
.optional-toggle { display: flex; align-items: center; gap: 5rpx; font-size: 23rpx; color: #56684f; }
.optional-toggle switch { transform: scale(.77); margin: 0 -6rpx 0 0; }
button.remove-row { width: 62rpx; max-width: 62rpx; height: 60rpx; display: flex; justify-content: center; align-items: center; margin: 0; padding: 0; color: #885248; font-size: 38rpx; line-height: 1; }
.step { background: #efefe3; padding: 14rpx 18rpx; border-radius: 18rpx; margin-top: 14rpx; }
.step-head { margin-bottom: 2rpx; min-height: 56rpx; font-weight: 650; }
.step-photo { width: 100%; height: 230rpx; display: block; border-radius: 14rpx; margin-top: 14rpx; }
.step-actions { display: flex; gap: 26rpx; }
.dock { position: fixed; bottom: 0; left: 0; right: 0; padding: 16rpx 34rpx calc(16rpx + env(safe-area-inset-bottom)); background: #f8f6ee; border-top: 1rpx solid #e0e2d4; }
